<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_ra" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.retention.advance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="after">
                <block title="Retention &amp; Advance Recovery" id="ra_settings">
                    <setting id="ra_retention_account" string="Retention Receivable Account"
                             help="Account holding the retention until the project is handed over. Must allow reconciliation and must not be of type Receivable.">
                        <field name="ra_retention_account_id" options="{'no_create': True}"/>
                    </setting>
                    <setting id="ra_default_retention" string="Default Retention %"
                             help="Proposed on every new customer invoice (can be changed per invoice).">
                        <field name="ra_default_retention_percent"/>
                    </setting>
                    <setting id="ra_journal" string="Retention Journal"
                             help="Miscellaneous journal for the retention, advance recovery and release entries. Leave empty to use the first miscellaneous journal.">
                        <field name="ra_journal_id" options="{'no_create': True}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
