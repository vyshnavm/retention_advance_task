<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_ra" model="ir.ui.view">
        <field name="name">account.payment.form.retention.advance</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_method_line_id']" position="after">
                <field name="ra_is_advance"
                       invisible="payment_type != 'inbound' or partner_type != 'customer'"/>
                <field name="ra_project_id"
                       invisible="not ra_is_advance"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
