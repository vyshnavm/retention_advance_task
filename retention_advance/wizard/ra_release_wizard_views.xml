<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ra_release_wizard_form" model="ir.ui.view">
        <field name="name">ra.release.wizard.form</field>
        <field name="model">ra.release.wizard</field>
        <field name="arch" type="xml">
            <form string="Release Retention">
                <group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="partner_id" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="date"/>
                    </group>
                </group>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0">
                        <field name="retention_line_id" column_invisible="1" force_save="1"/>
                        <field name="invoice_id" readonly="1"/>
                        <field name="project_id" readonly="1"/>
                        <field name="due_date" readonly="1"/>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="balance" readonly="1" sum="Total held"/>
                        <field name="release_amount" sum="Total to release"/>
                    </list>
                </field>
                <footer>
                    <button name="action_release" string="Release" type="object" class="btn-primary"
                            data-hotkey="q"/>
                    <button name="action_fill_full" string="Fill Full Balance" type="object"
                            class="btn-secondary"/>
                    <button string="Cancel" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_ra_release_wizard" model="ir.actions.act_window">
        <field name="name">Release Retention</field>
        <field name="res_model">ra.release.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_ra_release_wizard_partner" model="ir.actions.act_window">
        <field name="name">Release Retention</field>
        <field name="res_model">ra.release.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">form,list</field>
    </record>
</odoo>
